{
  "name": "@workspace/samadhi-love-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test:languages": "node scripts/test-music-languages.mjs",
    "test:library": "node scripts/test-song-library.mjs",
    "test:duration": "node scripts/test-track-duration.mjs",
    "test:genres": "node scripts/test-genres.mjs",
    "test:styles": "node scripts/test-style-suggestions.mjs",
    "test:audiovisual": "node scripts/test-av-timeline.mjs",
    "verify:studio": "node scripts/verify-studio.mjs",
    "test:integrity": "node scripts/test-internal-integrity.mjs",
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "vinext build",
    "build:cloudflare": "STUDIO_BUILD_TARGET=cloudflare vinext build",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/start-production.mjs",
    "preview:worker": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "test:runtime": "node --test tests/production-runtime.test.mjs",
    "test:workflow": "node scripts/test-project-workflow.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:voice-rights": "node scripts/test-voice-rights.mjs",
    "test:production": "node scripts/test-production-refinements.mjs",
    "test:radio": "node scripts/test-radio.mjs",
    "test:meditative": "node scripts/test-meditative.mjs",
    "test:audio-downloads": "node scripts/test-audio-downloads.mjs",
    "test:credits": "node scripts/test-credits.mjs",
    "test:elevenlabs": "node --test tests/elevenlabs-music-sdk.test.mjs tests/studio-auth.test.mjs tests/elevenlabs-vault.test.mjs tests/vault-key-setup.test.mjs tests/owner-provider-setup.test.mjs",
    "test:membership": "node scripts/test-membership-billing.mjs && node scripts/test-membership-controls.mjs",
    "test:presets": "node scripts/test-song-presets.mjs",
    "test:audio-edit": "node scripts/test-song-audio-edit.mjs",
    "test:quick-mode": "node scripts/test-quick-create-mode.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@clerk/react": "^6.18.8",
    "@clerk/shared": "^4.45.1",
    "@clerk/themes": "^2.4.57",
    "@elevenlabs/elevenlabs-js": "^2.78.0",
    "@hookform/resolvers": "^5.7.1",
    "@mediabunny/mp3-encoder": "1.65.2",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "0.8.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "mediabunny": "1.65.2",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.37",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "fake-indexeddb": "6.2.8",
    "jsdom": "26.1.0",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.5",
    "vite": "8.0.13",
    "webpack": "^5.112.2",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
